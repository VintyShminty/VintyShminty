NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Matches docker-compose.yml at the repo root
DATABASE_URL=postgres://vinty:vinty@localhost:5432/vintyshminty
# Comma separated list of allowed origins. Use * to allow all (development only).
CORS_ORIGIN=*
# The website's addresses, comma separated. Online: https://<website project>.vercel.app
# In development http://localhost:3001 is trusted without listing it.
WEB_ORIGINS=

# ---- Better Auth ----
# Signs sessions. This placeholder only works in development. Online use: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
# Public address of this server. For a real phone use your Mac's network address, for example http://192.168.1.20:3000
BETTER_AUTH_URL=http://localhost:3000
APP_SCHEME=vinty
# Sign up, log in and code requests allowed per minute per IP
AUTH_RATE_LIMIT_MAX=10
# Sign in with Google and Apple. Each stays off (its button is hidden in the app) until its values are filled in.
# Step by step guide: docs/going-online.md, Part J.
# Google: the WEB client from Google Cloud. Its redirect address is BETTER_AUTH_URL + /api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: the app ID (bundle id). This one value switches Apple on. Phone sign in checks tokens against it.
APPLE_APP_BUNDLE_IDENTIFIER=
# Apple key (.p8) values. Optional now, needed later to remove the link when someone deletes their account.
# With all three the server makes Apple's secret itself. Paste the key on one line, with \n for each line break.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Only for the website's Apple button: the Services ID (for example com.secondhand.marketplace.web), with the key values
# above (or a ready made APPLE_CLIENT_SECRET). Without them the website hides the Apple button, the phone is not affected.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ---- Email ----
# Development: Mailpit from docker-compose. Open the inbox at http://localhost:8025
# Online: MAIL_TRANSPORT=resend with RESEND_API_KEY, or MAIL_TRANSPORT=log for a private test (emails go to the server log).
# MAIL_TRANSPORT=resend with RESEND_API_KEY. Without a verified domain Resend only sends from
# onboarding@resend.dev and only delivers to the email address of the Resend account owner.
MAIL_TRANSPORT=smtp
RESEND_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
# Leave empty for the right default: no-reply@vinty.local for SMTP, onboarding@resend.dev for Resend.
# Once a domain is verified in Resend, for example: Vinty <hello@yourdomain.com>
MAIL_FROM=

# ---- Push notifications ----
# log: write each push to the server log instead of sending it (right for development and tests).
# expo: send through the Expo push service. Real delivery to iPhones needs Apple credentials in EAS (not set up yet).
# Empty means log, except in production where it means expo.
PUSH_TRANSPORT=log
# EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
# Only if "enhanced push security" is on for the Expo project:
EXPO_ACCESS_TOKEN=

# ---- Offers and orders ----
# Background jobs (expire offers, release held items, cancel unshipped orders, complete delivered ones), every N seconds. 0 = off.
JOBS_INTERVAL_SECONDS=30
# Pretend delivery: a shipped order becomes delivered N seconds after it shipped. Empty = 45 in development, off elsewhere. 0 = off.
# SIMULATED_DELIVERY_SECONDS=45

# Timers inside the server. Empty = on, except on Vercel (VERCEL=1 is set there by Vercel) where they are off and the
# crons in apps/server/vercel.json call the endpoints below instead. Force with true or false.
# IN_PROCESS_JOBS=

# ---- Scheduler (Vercel Cron or any other) ----
# GET or POST /v1/jobs/orders, /v1/jobs/feed-popularity, /v1/jobs/feed-cleanup and /v1/jobs/all need the header
# "Authorization: Bearer <this value>". Vercel Cron sends it by itself when the project has a CRON_SECRET variable.
# Empty switches the endpoints off (and production refuses to start). Make one with: openssl rand -base64 32
CRON_SECRET=

# ---- Live chat across several servers ----
# Empty = messages stay in this server's memory (right for one server, and for your laptop).
# Online (Vercel runs many copies): the rediss:// address of the Upstash Redis database.
REDIS_URL=

# ---- Database connection (online) ----
# Neon's pooled address (has -pooler in it) needs prepared statements off. Empty = decided from the address.
# DATABASE_PREPARED_STATEMENTS=false
# Connections one server copy keeps open
# DATABASE_POOL_MAX=10

# ---- Photo storage ----
# Development: MinIO from docker-compose.
# Online: Cloudflare R2. S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com, S3_REGION=auto, S3_BUCKET=<bucket name>,
# keys from an R2 API token (Object Read and Write), S3_FORCE_PATH_STYLE=true, and S3_PUBLIC_URL=<the bucket's public
# address, https://pub-xxxx.r2.dev or a custom domain, no trailing slash and no bucket name>
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vinty-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/vinty-dev

# ---- AI photo helper (sell form) ----
# Reads the seller's photos with Claude Haiku and suggests the category, brand, colours, title and description.
# Empty means the helper is off: nothing breaks, the sell form just has no suggestions. Never commit a real key.
ANTHROPIC_API_KEY=
# Google Places (API New) key for city and address suggestions. Leave empty to turn suggestions off.
GOOGLE_MAPS_API_KEY=
# Empty means claude-haiku-5-5
PHOTO_READER_MODEL=
