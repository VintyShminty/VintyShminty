NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Matches docker-compose.yml at the repo root
DATABASE_URL=postgres://vinty:vinty@localhost:5432/vintyshminty
# Comma separated list of allowed origins. Use * to allow all (development only).
CORS_ORIGIN=*

# ---- Better Auth ----
# Signs sessions. This placeholder only works in development. Online use: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
# Public address of this server. For a real phone use your Mac's network address, for example http://192.168.1.20:3000
BETTER_AUTH_URL=http://localhost:3000
APP_SCHEME=vinty
# Sign up, log in and code requests allowed per minute per IP
AUTH_RATE_LIMIT_MAX=10
# Google and Apple sign in stay off until these are filled in (see CLAUDE.md, Accounts and services)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

# ---- Email ----
# Development: Mailpit from docker-compose. Open the inbox at http://localhost:8025
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=Vinty <no-reply@vinty.local>

# ---- Push notifications ----
# log: write each push to the server log instead of sending it (right for development and tests).
# expo: send through the Expo push service. Real delivery to iPhones needs Apple credentials in EAS (not set up yet).
# Empty means log, except in production where it means expo.
PUSH_TRANSPORT=log
# EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
# Only if "enhanced push security" is on for the Expo project:
EXPO_ACCESS_TOKEN=

# ---- Offers and orders ----
# Background jobs (expire offers, release held items, cancel unshipped orders, complete delivered ones), every N seconds. 0 = off.
JOBS_INTERVAL_SECONDS=30
# Pretend delivery: a shipped order becomes delivered N seconds after it shipped. Empty = 45 in development, off elsewhere. 0 = off.
# SIMULATED_DELIVERY_SECONDS=45

# ---- Photo storage ----
# Development: MinIO from docker-compose. Online: Cloudflare R2 (endpoint https://<account>.r2.cloudflarestorage.com, region auto)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vinty-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/vinty-dev
