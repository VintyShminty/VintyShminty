{
  "name": "@vinty/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --no-file-parallelism",
    "admin-grant": "tsx --env-file-if-exists=.env src/scripts/admin-grant.ts",
    "admin-grant:online": "tsx --env-file=../../packages/db/.env.online src/scripts/admin-grant.ts",
    "dev-users": "tsx --env-file-if-exists=.env src/scripts/dev-users.ts",
    "storage-seed": "tsx --env-file-if-exists=.env src/scripts/storage-seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@better-auth/drizzle-adapter": "^1.7.15",
    "@better-auth/expo": "^1.7.15",
    "@fastify/cors": "^11.4.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/sensible": "^6.0.7",
    "@socket.io/redis-adapter": "^8.3.0",
    "@vercel/functions": "^3.10.5",
    "@vinty/db": "workspace:*",
    "@vinty/locales": "workspace:*",
    "@vinty/shared": "workspace:*",
    "better-auth": "^1.7.15",
    "blurhash": "^2.0.5",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.15",
    "nodemailer": "^10.3.1",
    "redis": "^6.3.1",
    "sharp": "^0.35.5",
    "socket.io": "4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "esbuild": "^0.28.2",
    "socket.io-client": "4.8.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "22.x"
  }
}
