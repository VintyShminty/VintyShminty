# Where the server lives. Used on the website's own server to forward /api/auth and /v1 calls, so the login
# cookie belongs to the website. Online this is the server's Vercel address.
API_URL=http://localhost:3000

# Where the browser connects for live chat (it cannot go through the forwarding). Same server address.
NEXT_PUBLIC_API_URL=http://localhost:3000

# The public address of the website, for link previews, the sitemap and language twins.
# Online set it to the real address (for example https://vinty-web-tan.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3001
