# Where the app finds the server. The iOS Simulator reaches your Mac at localhost.
# On a real phone use your Mac address, for example http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# To talk to the ONLINE server (Vercel + Cloudflare R2), for the simulator or a build, use this instead
# (docs/going-online.md). It is a public value: nothing secret goes in an EXPO_PUBLIC_ variable.
# EXPO_PUBLIC_API_URL=https://<your-project>.vercel.app

# Where the website lives. The app uses its /app-check page for the bot check on sign up and log in (Cloudflare
# Turnstile). Empty switches the check off in the app. Online use the real website address.
EXPO_PUBLIC_WEB_URL=http://localhost:3001
