# Where the app finds the server. The iOS Simulator reaches your Mac at localhost.
# On a real phone use your Mac address, for example http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
# Where the Browse tile photos are served from (the server's S3_PUBLIC_URL). Same rule: Mac address on a real phone.
# EXPO_PUBLIC_STORAGE_URL=http://localhost:9000/vinty-dev

# To talk to the ONLINE server (Vercel + Cloudflare R2), for the simulator or a build, use these two instead
# (docs/going-online.md). Both are public values: nothing secret goes in an EXPO_PUBLIC_ variable.
# EXPO_PUBLIC_API_URL=https://<your-project>.vercel.app
# EXPO_PUBLIC_STORAGE_URL=https://pub-xxxx.r2.dev
