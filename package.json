{
  "name": "vintyshminty",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:mobile": "pnpm --filter @vinty/mobile start",
    "dev:server": "pnpm --filter @vinty/server dev",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm -r --parallel --if-present test",
    "db:up": "docker compose up -d --wait postgres mailpit minio",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @vinty/db generate",
    "db:migrate": "pnpm --filter @vinty/db migrate",
    "db:seed": "pnpm --filter @vinty/db seed",
    "db:seed:reference": "pnpm --filter @vinty/db seed:reference",
    "db:reset": "pnpm --filter @vinty/db reset",
    "db:dev-users": "pnpm --filter @vinty/server dev-users",
    "storage:seed": "pnpm --filter @vinty/server storage-seed"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "typescript": "~7.0.2"
  }
}
