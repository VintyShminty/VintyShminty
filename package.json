{
  "name": "vintyshminty",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:mobile": "pnpm --filter @vinty/mobile start",
    "dev:server": "pnpm --filter @vinty/server dev",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm -r --parallel --if-present test",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @vinty/db generate",
    "db:migrate": "pnpm --filter @vinty/db migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "typescript": "~6.0.3"
  }
}
